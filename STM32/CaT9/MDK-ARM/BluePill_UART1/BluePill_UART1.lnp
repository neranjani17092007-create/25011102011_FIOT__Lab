"bluepill_uart1\stm32f1xx_hal_rcc_ex.o"
"bluepill_uart1\stm32f1xx_hal_gpio.o"
"bluepill_uart1\stm32f1xx_hal_dma.o"
"bluepill_uart1\stm32f1xx_hal_cortex.o"
